{
  "name": "gridmdm",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "start": "turbo run start"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "prettier": "^3.7.4",
    "shadcn": "^4.1.0",
    "tailwindcss": "^4",
    "turbo": "^2.8.20",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
